#!/bin/bash

pkill opendeck
close-midi

if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
  TV_SCREEN=HDMI-0
  SECONDARY_MONITOR="eDP-1-1"
else

  $HOME/.screenlayout/la-sala-del-starcraft-invertida.sh

  ibus engine xkb:us:intl:eng

  feh --randomize --bg-fill ~/Pictures/wallpapers/

  TV_SCREEN=HDMI-0
  SECONDARY_MONITOR="eDP-1-1"
  xset r rate 300 100
fi

i3-msg "workspace number 10; move workspace to output $TV_SCREEN; workspace number 1"
i3-msg "workspace number 8; move workspace to output $SECONDARY_MONITOR; workspace number 1"

sed -i 's/font pango:monospace 11/font pango:monospace 17/' /home/i3morhook/.config/i3/config
sed -i 's/font pango:monospace 11/font pango:monospace 17/' /home/i3morhook/.config/sway/config

sed -i 's/ *tray_output .*/        tray_output DP-2/' /home/i3morhook/.config/sway/config

i3-msg reload
