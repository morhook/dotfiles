#!/bin/bash

pkill opendeck
close-midi

if ! ps aux | rg -v rg| rg librepods; then
  nohup librepods &
fi

if [ "$XDG_SESSION_TYPE" = "wayland"]; then
  echo doing nothing
else
  $HOME/.screenlayout/laptop.sh
  ibus engine xkb:us:intl:eng
  feh --randomize --bg-fill ~/Pictures/wallpapers/
  xset r rate 300 100
fi



sed -i 's/font pango:monospace 11/font pango:monospace 17/' /home/i3morhook/.config/i3/config
sed -i "s/bindsym \$mod+d exec --no-startup-id dmenu_run -fn 'monospace:size=11'/bindsym \$mod+d exec --no-startup-id dmenu_run -fn 'monospace:size=17'/" \
        /home/i3morhook/.config/i3/config
sed -i 's/font pango:monospace 11/font pango:monospace 17/' /home/i3morhook/.config/sway/config
sed -i 's/ *tray_output .*/        tray_output eDP-1/' /home/i3morhook/.config/sway/config
i3-msg reload




if [ "$XDG_SESSION_DESKTOP" = "hyprland"]; then
  cp $HOME/.config/hypr/home.conf $HOME/.config/hypr/monitors.conf
  restart-waybar
fi
